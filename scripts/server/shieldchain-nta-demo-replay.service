[Unit]
Description=ShieldChain allowlisted NTA demo replay runner
After=docker.service

[Service]
Type=simple
WorkingDirectory=/home/user/jhk/project/ShieldChain
EnvironmentFile=/home/user/jhk/shieldchain-private/demo-replay.env
SupplementaryGroups=docker
ExecStart=/home/user/jhk/shieldchain-validation/20260905/venv/bin/python /home/user/jhk/project/ShieldChain/scripts/nta/replay/demo_runner.py --manifest /home/user/jhk/shieldchain-private/demo-replay-samples.json --pcap-root /home/user/jhk/nta-dataset/pcap --runtime-root /home/user/jhk/shieldchain-runtime/demo-replay --host 172.18.0.1 --port 18082
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
