# ShieldChain NTA custom detection rules
# Local SID range: 9000001-9000999
# These rules alert only. They must not trigger automatic blocking without review.
# v2: protocol-behaviour signatures developed on the development split only.

alert http any any -> any any (msg:"ShieldChain JBoss JMXInvokerServlet access"; flow:established,to_server; http.uri; content:"/invoker/JMXInvokerServlet"; nocase; classtype:web-application-attack; sid:9000001; rev:1;)
alert http any any -> any any (msg:"ShieldChain JBoss HTTPServerILServlet exploit endpoint"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/jbossmq-httpil/HTTPServerILServlet"; nocase; classtype:web-application-attack; sid:9000002; rev:1;)
alert http any any -> any any (msg:"ShieldChain HTTP raw URI path traversal attempt"; flow:established,to_server; http.uri.raw; content:"../"; classtype:web-application-attack; sid:9000003; rev:2;)
alert http any any -> any any (msg:"ShieldChain suspicious WebShell endpoint"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"shell."; nocase; classtype:web-application-attack; sid:9000004; rev:2;)
alert http any any -> any ![5985,5986] (msg:"ShieldChain unusually large HTTP POST request"; flow:established,to_server; http.method; content:"POST"; http.content_len; pcre:"/^[1-9][0-9]{4,}$/"; classtype:bad-unknown; threshold:type limit, track by_src, count 5, seconds 60; sid:9000005; rev:4;)
alert http any any -> any any (msg:"ShieldChain malformed duplicated User-Agent prefix"; flow:established,to_server; http.method; content:"POST"; http.user_agent; content:"User-Agent|3a|"; startswith; nocase; classtype:bad-unknown; sid:9000006; rev:2;)
alert http any any -> any any (msg:"ShieldChain encoded URI path traversal token"; flow:established,to_server; http.uri.raw; content:"%2e%2e"; nocase; classtype:web-application-attack; sid:9000008; rev:1;)
alert http any any -> any any (msg:"ShieldChain null-byte token in HTTP URI"; flow:established,to_server; http.uri.raw; content:"%00"; nocase; classtype:web-application-attack; sid:9000009; rev:1;)

