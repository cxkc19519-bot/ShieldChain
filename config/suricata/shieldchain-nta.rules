alert http any any -> any any (msg:"ShieldChain multi-family WebShell administration cookies"; flow:established,to_server; http.cookie; content:"Backdoor="; nocase; content:"wso="; nocase; content:"b374k="; nocase; classtype:web-application-attack; sid:9000052; rev:1;)
