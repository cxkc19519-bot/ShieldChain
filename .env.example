DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RUN_LIVE_DEEPSEEK_TEST=0
DATABASE_URL=sqlite:///./data/shieldchain.db
ENVIRONMENT=development
HTTP_ALLOWED_HOSTS=["127.0.0.1","localhost"]
HTTP_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
HTTP_MAX_REQUEST_BYTES=27262976
MCP_SERVER_ENABLED=false
MCP_AUTH_MODE=disabled
MCP_AUTH_ISSUER=
MCP_AUTH_RESOURCE=
MCP_AUTH_JWKS_URL=
MCP_AUTH_AUDIENCE=
MCP_AUTH_ALGORITHM=RS256
MCP_AUTH_MAX_TOKEN_LIFETIME_SECONDS=900
MCP_AUTH_SUBJECT_PRINCIPALS={}

# Set a long random value only after the Wazuh manager-side webhook adapter is deployed.
WAZUH_WEBHOOK_TOKEN=
WAZUH_REVIEW_MIN_SEVERITY=12
WAZUH_REVIEW_CORRELATION_WINDOW_SECONDS=900
