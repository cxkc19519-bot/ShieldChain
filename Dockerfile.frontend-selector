FROM docker.m.daocloud.io/library/node:24-alpine3.22 AS builder
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm test -- --run src/features/qwen/QwenChatPage.test.tsx && npm run build
FROM shieldchain-frontend:local
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder --chown=101:101 /build/frontend/dist /usr/share/nginx/html
